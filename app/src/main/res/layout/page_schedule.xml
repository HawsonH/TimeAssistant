<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/scheduleEyebrow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TimeAssistant.Eyebrow" />

            <TextView
                android:id="@+id/scheduleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TimeAssistant.PageTitle" />
        </LinearLayout>

        <ImageView
            android:id="@+id/addTaskButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/add_task"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_add"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <com.hawson.timeassistant.design.SlidingSegmentedControl
        android:id="@+id/scheduleSegments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_segment"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/scheduleTabButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/schedule_view"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/schedule_tab"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/todoTabButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/todo_view"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/todo_tab"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reflowTabButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/schedule_attention_content_description"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/schedule_attention"
            android:textSize="13sp"
            android:textStyle="bold" />
    </com.hawson.timeassistant.design.SlidingSegmentedControl>

    <LinearLayout
        android:id="@+id/dateNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/previousDateButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous_date"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/text_primary" />
        <TextView
            android:id="@+id/selectedDateButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
        <Button
            android:id="@+id/todayButton"
            style="@style/Widget.TimeAssistant.Button.Neutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="104dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_segment"
            android:visibility="invisible"
            android:text="@string/return_today" />
        <ImageButton
            android:id="@+id/nextDateButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_date"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scheduleScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/scheduleBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp" />
    </ScrollView>
</LinearLayout>
