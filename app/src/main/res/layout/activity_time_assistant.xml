<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.hawson.timeassistant.design.SlidingIndicatorLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@color/ui_glass"
        android:baselineAligned="false"
        android:elevation="1dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/nav_chat"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/navChatIcon"
                android:layout_width="40dp"
                android:layout_height="29dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_nav_chat"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/navChatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/nav_chat"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSchedule"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/nav_schedule"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/navScheduleIcon"
                android:layout_width="40dp"
                android:layout_height="29dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_nav_schedule"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/navScheduleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/nav_schedule"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFocus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/nav_focus"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/navFocusIcon"
                android:layout_width="40dp"
                android:layout_height="29dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/ic_nav_focus"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/navFocusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/nav_focus"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.hawson.timeassistant.design.SlidingIndicatorLayout>
</LinearLayout>
