<?xml version="1.0" encoding="utf-8"?>
<com.hawson.timeassistant.ui.FocusViewport xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/focusContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="0dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4">

            <com.hawson.timeassistant.ui.widget.TimerRingView
                android:id="@+id/timerRing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="true"
                android:contentDescription="@string/focus_timer_action_hint"
                android:focusable="true" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/focusEyebrow"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/focus_eyebrow"
                        android:textAppearance="@style/TextAppearance.TimeAssistant.Eyebrow" />

                    <TextView
                        android:id="@+id/focusModeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TimeAssistant.PageTitle" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/focusSettingsButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/focus_options"
                    android:padding="12dp"
                    android:src="@drawable/ic_more"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/focusModes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/focusModeFocus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/focus_mode_focus"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/focusModeShort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/focus_mode_short"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/focusModeLong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/focus_mode_long"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/focusGestureHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/focus_gesture_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/focusTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:id="@+id/focusActions"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/timerButton"
                    style="@style/Widget.TimeAssistant.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:textSize="15sp" />

                <FrameLayout
                    android:id="@+id/endFocusSlot"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="0.7">
                    <Button
                        android:id="@+id/endFocusButton"
                        style="@style/Widget.TimeAssistant.Button.Danger"
                        android:background="@drawable/bg_focus_end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/focus_end" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.hawson.timeassistant.ui.FocusViewport>
