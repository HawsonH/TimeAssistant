<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="sharedpref" path="ai_auxiliary_v1.xml" />
    <exclude domain="database" path="ai_call_usage.db" />
    <exclude domain="database" path="ai_call_usage.db-shm" />
    <exclude domain="database" path="ai_call_usage.db-wal" />
    <exclude domain="sharedpref" path="ai_connection_credentials.xml" />
    <exclude domain="sharedpref" path="ai_connection_profiles.xml" />
    <!-- API credentials are device-bound Android Keystore ciphertext and are never backed up. -->
    <exclude domain="sharedpref" path="time_assistant_secrets.xml" />
    <exclude domain="sharedpref" path="local_intelligence_settings.xml" />
    <exclude domain="sharedpref" path="ai_endpoint_trust.xml" />
    <exclude domain="database" path="time_assistant_local_ai.db" />
    <exclude domain="database" path="time_assistant_local_ai.db-shm" />
    <exclude domain="database" path="time_assistant_local_ai.db-wal" />
</full-backup-content>
