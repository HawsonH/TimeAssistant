<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aiConnectionsFeature"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:saveEnabled="true">
    <TextView android:id="@+id/notice" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp"
        android:accessibilityLiveRegion="polite" android:paddingBottom="8dp" />
    <LinearLayout android:id="@+id/list" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" />
    <include android:id="@+id/editor" layout="@layout/view_ai_editor"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
